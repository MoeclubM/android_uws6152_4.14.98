			debounce-interval = <0x02>;
			gpios = <0x41 0x01 0x01>;
			linux,code = <0x74>;
			label = "Power Key";
		};

		key_ai {
			gpio-key,level-trigger;
			gpio-key,wakeup;
			debounce-interval = <0x02>;
			gpios = <0x23 0x02 0x01>;
			linux,code = <0x43>;
			label = "Ai Key";
		};
	};

	fingerprint@0 {
