				sound-dai = <0xbf>;
			};

			cpu {
				sound-dai = <0xc0 0x2c>;
			};

			codec {
				sound-dai = <0xc1 0x00>;
			};
		};
	};

	memory {
		reg = <0x00 0x80000000 0x00 0xfffff000>;
		device_type = "memory";
		phandle = <0xc3>;
	};

	chosen {
		stdout-path = "/soc/ap-apb/serial@70100000";
		bootargs = "earlycon=sprd_serial,0x70100000,115200n8 console=ttyS1,115200n8 loop.max_part=7 loglevel=1  swiotlb=1 init=/init root=/dev/mmcblk0p33 rootfstype=ext4 ro rootwait androidboot.hardware=uws6152_1h10_go androidboot.dtbo_idx=0 printk.devkmsg=on lcd_id=ID5300 lcd_name=lcd_co5300_mipi_410x502_qc_hd lcd_base=9eb0c000 lcd_size=502x408 pixel_clock=13800000 logo_bpix=8  sysdump_magic=85500000 modem=shutdown ltemode=lcsfb rfboard.id=0 rfhw.id=40 crystal=4 32k.less=0 androidboot.pmic.chipid=2730 modemboot.method=emmcboot  androidboot.verifiedbootstate=green androidboot.flash.locked=1  androidboot.serialno=0123456789ABCDEF";
	};

	interrupt-controller {
		compatible = "android,CustomIPI";
		#interrupt-cells = <0x01>;
		interrupt-controller;
		phandle = <0xc2>;
	};

	trusty {
		compatible = "android,trusty-smc-v1";

		irq {
			compatible = "android,trusty-irq-v1";
			interrupt-templates = <0xc2 0x00 0x01 0x01 0x01 0x00 0x01 0x01 0x00 0x00>;
			interrupt-ranges = <0x00 0x0f 0x00 0x10 0x1f 0x01 0x20 0xdf 0x02>;
		};

		virtio {
			compatible = "android,trusty-virtio-v1";
		};

		log {
			compatible = "android,trusty-log-v1";
		};
	};

